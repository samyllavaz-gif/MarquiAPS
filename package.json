{
  "name": "marqui-aps",
  "version": "2.0.0",
  "private": true,
  "description": "Marqui APS — ferramentas de apoio à consulta na Atenção Primária (site estático, sem servidor de aplicação).",
  "type": "module",
  "scripts": {
    "start": "node scripts/servidor.js",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node tests/e2e/regressao.js",
    "test:e2e:atualizar": "node tests/e2e/regressao.js --atualizar",
    "lint": "eslint js tests scripts",
    "format": "prettier --write \"js/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.js\"",
    "format:check": "prettier --check \"js/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.js\"",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10"
  }
}
